---
// Monetized "devices in this guide" block. Buy CTAs reuse only affiliate links /
// prices already in review frontmatter (or a live deal); never a fabricated store URL.
interface Deal {
  url: string;
  price: number;
  wasPrice?: number;
  retailer: string;
  discountPct?: number;
}
interface Item {
  href: string;        // review page
  name: string;        // device name
  rating: number;
  price?: number;      // launch/reference price from frontmatter
  affiliate?: string;  // affiliate URL from frontmatter
  deal?: Deal;         // cheapest live deal, if any
}
interface Props {
  items: Item[];
  heading?: string;
  label?: string;
}
const { items, heading = 'Devices in this guide', label = '// On the bench' } = Astro.props;
---
{items.length > 0 && (
  <section class="max-w-3xl mx-auto px-4 pb-20">
    <div class="smpte-bars h-px w-full mb-8 opacity-50"></div>
    <span class="label text-signal">{label}</span>
    <div class="flex items-end justify-between gap-4 mt-1 mb-2">
      <h2 class="font-display font-800 text-2xl">{heading}</h2>
    </div>
    <p class="label text-dim mb-6">
      Affiliate links — we may earn a commission; it never changes our verdict.
      <a href="/how-we-test" class="hover:text-signal transition-colors">How we test →</a>
    </p>
    <div class="grid sm:grid-cols-3 gap-4">
      {items.map((i) => (
        <div class="bench-card frame p-4 flex flex-col">
          <div class="flex items-center justify-between mb-2">
            <span class="font-display font-900 text-lg text-signal leading-none">
              {i.rating.toFixed(1)}<span class="label text-dim"> /5</span>
            </span>
            {i.deal?.discountPct && (
              <span class="font-mono text-xs font-semibold text-void bg-signal px-1.5 py-0.5">-{i.deal.discountPct}%</span>
            )}
          </div>
          <a href={i.href} class="font-display font-700 text-sm text-ink hover:text-signal transition-colors leading-snug mb-3 flex-1">
            {i.name}
          </a>
          {i.deal ? (
            <>
              <div class="flex items-end gap-1.5 mb-2">
                <span class="font-display font-900 text-xl text-signal leading-none">${i.deal.price}</span>
                {i.deal.wasPrice && <span class="font-mono text-xs text-dim line-through mb-0.5">${i.deal.wasPrice}</span>}
                <span class="label text-dim ml-auto">{i.deal.retailer}</span>
              </div>
              <a href={i.deal.url} target="_blank" rel="noopener sponsored" class="btn-signal !py-2 text-center">Get deal →</a>
            </>
          ) : i.affiliate ? (
            <a href={i.affiliate} target="_blank" rel="noopener sponsored" class="btn-signal !py-2 text-center">
              Check price{i.price ? ` · $${i.price}` : ''} →
            </a>
          ) : (
            <a href={i.href} class="btn-ghost !py-2 text-center">Read review →</a>
          )}
        </div>
      ))}
    </div>
  </section>
)}
