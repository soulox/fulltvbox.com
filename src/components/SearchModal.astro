---
// Site-wide search modal powered by Pagefind (index built at `astro build`).
// Triggered by any [data-search-open] element, the `/` key, or Cmd/Ctrl-K.
---
<div id="search-overlay" class="search-overlay" hidden>
  <div
    id="search-dialog"
    class="search-dialog panel frame"
    role="dialog"
    aria-modal="true"
    aria-label="Search FullTVBox"
  >
    <div class="smpte-bars h-1 w-full"></div>
    <div class="flex items-center gap-3 px-4 py-3 border-b border-line">
      <span class="label text-signal shrink-0">⌕ FIND</span>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search reviews, guides, tutorials…"
        aria-label="Search query"
        class="flex-1 bg-transparent text-ink font-mono text-sm outline-none placeholder:text-dim"
      />
      <button data-search-close class="label text-dim hover:text-signal transition-colors shrink-0" aria-label="Close search">ESC</button>
    </div>

    <div id="search-results" role="listbox" aria-label="Search results" class="max-h-[60vh] overflow-y-auto"></div>

    <div class="flex items-center justify-between px-4 py-2.5 border-t border-line label text-dim">
      <span>↑ ↓ navigate · ↵ open · esc close</span>
      <span class="text-signal">Pagefind</span>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed; inset: 0; z-index: 100;
    background: rgba(6, 8, 11, 0.82);
    backdrop-filter: blur(6px);
    display: flex; align-items: flex-start; justify-content: center;
    padding: 12vh 1rem 1rem;
  }
  .search-overlay[hidden] { display: none; }
  .search-dialog {
    width: 100%; max-width: 40rem; overflow: hidden;
    box-shadow: 0 30px 80px -30px rgba(0,0,0,0.95);
    animation: search-in 0.16s cubic-bezier(0.2,0.7,0.2,1);
  }
  @keyframes search-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .search-dialog { animation: none; } }

  :global(#search-results .sr-item) {
    display: block; padding: 0.8rem 1rem; border-bottom: 1px solid var(--line);
    transition: background 0.12s;
  }
  :global(#search-results .sr-item:hover),
  :global(#search-results .sr-item[aria-selected="true"]) { background: var(--panel2); }
  :global(#search-results .sr-item[aria-selected="true"]) { box-shadow: inset 3px 0 0 var(--signal); }
  :global(#search-results .sr-title) {
    font-family: "Archivo", sans-serif; font-weight: 700; color: var(--ink); font-size: 0.95rem;
  }
  :global(#search-results .sr-item[aria-selected="true"] .sr-title) { color: var(--signal); }
  :global(#search-results .sr-type) {
    font-family: "IBM Plex Mono", monospace; font-size: 0.6rem; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--signal); margin-left: 0.5rem;
  }
  :global(#search-results .sr-excerpt) {
    color: var(--muted); font-size: 0.8rem; margin-top: 0.2rem; line-height: 1.5;
  }
  :global(#search-results .sr-excerpt mark) { background: transparent; color: var(--signal); font-weight: 600; }
  :global(#search-results .sr-empty) {
    padding: 2rem 1rem; text-align: center; color: var(--dim);
    font-family: "IBM Plex Mono", monospace; font-size: 0.8rem;
  }
</style>

<script>
  const overlay = document.getElementById('search-overlay') as HTMLElement;
  const dialog = document.getElementById('search-dialog') as HTMLElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLElement;

  let pagefind: any = null;
  let lastTrigger: HTMLElement | null = null;
  let selected = -1;
  let items: HTMLAnchorElement[] = [];

  const TYPE = (url: string) =>
    url.includes('/reviews/') ? 'review' : url.includes('/guides/') ? 'guide' : url.includes('/tutorials/') ? 'tutorial' : '';

  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      const src = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ src);
      await pagefind.options({ excerptLength: 18 });
      await pagefind.init();
    } catch {
      pagefind = { unavailable: true };
    }
    return pagefind;
  }

  function open(trigger?: HTMLElement) {
    lastTrigger = trigger ?? null;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    renderEmpty('Type to search the bench archive…');
    requestAnimationFrame(() => input.focus());
    loadPagefind();
  }
  function close() {
    overlay.hidden = true;
    document.body.style.overflow = '';
    selected = -1;
    lastTrigger?.focus();
  }

  function renderEmpty(msg: string) {
    results.innerHTML = `<div class="sr-empty">${msg}</div>`;
    items = [];
    selected = -1;
  }

  function setSelected(next: number) {
    if (!items.length) return;
    selected = (next + items.length) % items.length;
    items.forEach((el, i) => el.setAttribute('aria-selected', String(i === selected)));
    items[selected]?.scrollIntoView({ block: 'nearest' });
  }

  let token = 0;
  async function run(query: string) {
    const my = ++token;
    const pf = await loadPagefind();
    if (my !== token) return;
    if (pf.unavailable) { renderEmpty('Search index not available — run a build first.'); return; }
    if (!query.trim()) { renderEmpty('Type to search the bench archive…'); return; }

    const search = await pf.search(query);
    if (my !== token) return;
    const data = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
    if (my !== token) return;

    if (!data.length) { renderEmpty(`No results for “${query}”.`); return; }

    results.innerHTML = data
      .map((d: any) => {
        const type = TYPE(d.url);
        return `<a class="sr-item" role="option" href="${d.url}">
          <span class="sr-title">${d.meta?.title ?? d.url}</span>${type ? `<span class="sr-type">${type}</span>` : ''}
          <div class="sr-excerpt">${d.excerpt}</div>
        </a>`;
      })
      .join('');
    items = Array.from(results.querySelectorAll('.sr-item')) as HTMLAnchorElement[];
    setSelected(0);
  }

  let debounce: number | undefined;
  input?.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = window.setTimeout(() => run(input.value), 140);
  });

  // result keyboard nav
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setSelected(selected + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setSelected(selected - 1); }
    else if (e.key === 'Enter' && items[selected]) { e.preventDefault(); items[selected].click(); }
  });

  // open triggers
  document.querySelectorAll('[data-search-open]').forEach((el) =>
    el.addEventListener('click', () => open(el as HTMLElement)),
  );
  document.querySelectorAll('[data-search-close]').forEach((el) => el.addEventListener('click', close));
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) close(); });

  // global shortcuts
  document.addEventListener('keydown', (e) => {
    const typing = /^(input|textarea|select)$/i.test((e.target as HTMLElement)?.tagName ?? '');
    if (!overlay.hidden && e.key === 'Escape') { e.preventDefault(); close(); return; }
    if ((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) {
      e.preventDefault();
      if (overlay.hidden) open();
    }
  });

  // basic focus trap
  dialog?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = dialog.querySelectorAll<HTMLElement>('a[href], button, input');
    if (!focusable.length) return;
    const first = focusable[0], last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
</script>
