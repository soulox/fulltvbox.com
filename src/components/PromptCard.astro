---
import { freshness } from '../lib/freshness';
import { promptGroupLabel, type Prompt } from '../lib/prompts';

interface Props {
  prompt: Prompt;
  showGroup?: boolean;
}
const { prompt, showGroup = false } = Astro.props;
const { data } = prompt.entry;
const fresh = freshness(data.publishDate, data.updatedDate);
---
<a href={prompt.href} class="bench-card frame group p-5 flex flex-col min-w-0">
  <div class="label mb-3 flex items-center gap-2 flex-wrap">
    <span class="text-signal">PROMPT</span>
    {showGroup && <span>· {promptGroupLabel(data.group)}</span>}
    {fresh === 'new' && <span class="chip text-signal border-signal/40">◆ NEW</span>}
    {fresh === 'updated' && <span class="chip text-scope border-scope/40">◆ UPDATED</span>}
  </div>
  <h3 class="font-display font-700 text-lg leading-snug text-ink group-hover:text-signal transition-colors mb-2 flex-1">
    {data.title}
  </h3>
  <p class="text-muted text-sm line-clamp-2 mb-4">{data.description}</p>
  <div class="flex items-center justify-between gap-3">
    <span class="label text-dim truncate min-w-0">Works with {prompt.tools.map((t) => t.name).join(', ')}</span>
    <span class="font-mono text-xs text-dim group-hover:text-signal transition-colors shrink-0">→ copy</span>
  </div>
</a>
