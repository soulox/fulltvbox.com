---
/**
 * Google Analytics 4, loaded only after the visitor accepts.
 *
 * GA sets cookies, so EU rules (GDPR + ePrivacy) need consent first: nothing from Google
 * loads until "Accept" is clicked. The choice is kept in localStorage; "Cookie settings" in
 * the footer reopens the banner, and withdrawing consent deletes the GA cookies.
 * Ad signals stay denied: this is audience measurement only. See /privacy.
 */
export const GA_ID = 'G-Y2PDZXKM42';
---
<div
  id="consent-banner"
  class="consent hidden"
  role="region"
  aria-label="Cookie consent"
  data-ga-id={GA_ID}
  data-pagefind-ignore
>
  <p class="text-sm text-ink/85">
    May we use Google Analytics to count visits and see which pages help? It sets cookies and
    is off unless you accept. <a href="/privacy#analytics" class="underline hover:text-signal">Details</a>
  </p>
  <div class="flex gap-2 shrink-0">
    <button type="button" class="btn-ghost" data-consent="denied">Decline</button>
    <button type="button" class="btn-ghost" data-consent="granted">Accept</button>
  </div>
</div>

<script>
  const KEY = 'ftb-analytics-consent';
  const banner = document.getElementById('consent-banner');
  const id = banner?.dataset.gaId ?? '';

  type W = Window & { dataLayer?: unknown[]; [k: string]: unknown };
  const w = window as W;

  function readChoice(): string | null {
    try { return localStorage.getItem(KEY); } catch { return null; }
  }
  function saveChoice(v: string) {
    try { localStorage.setItem(KEY, v); } catch { /* private mode: ask again next page */ }
  }

  let loaded = false;
  function loadGa() {
    if (loaded || !id) return;
    loaded = true;
    w[`ga-disable-${id}`] = false;
    w.dataLayer = w.dataLayer || [];
    // gtag() must push the arguments object itself, not an array.
    function gtag(..._args: unknown[]) { w.dataLayer!.push(arguments); }
    gtag('consent', 'default', {
      analytics_storage: 'granted',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });
    gtag('js', new Date());
    gtag('config', id);
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
    document.head.appendChild(s);
  }

  function clearGaCookies() {
    const host = location.hostname;
    const domains = ['', host, `.${host}`, `.${host.split('.').slice(-2).join('.')}`];
    for (const c of document.cookie.split(';')) {
      const name = c.split('=')[0].trim();
      if (!name.startsWith('_ga')) continue;
      for (const d of domains) {
        document.cookie = `${name}=; Max-Age=0; path=/${d ? `; domain=${d}` : ''}`;
      }
    }
  }

  const show = () => banner?.classList.remove('hidden');
  const hide = () => banner?.classList.add('hidden');

  banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => {
      const choice = b.dataset.consent!;
      saveChoice(choice);
      hide();
      if (choice === 'granted') loadGa();
      else {
        w[`ga-disable-${id}`] = true;
        clearGaCookies();
      }
    })
  );

  document.querySelectorAll('[data-consent-open]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); show(); })
  );

  const choice = readChoice();
  if (choice === 'granted') loadGa();
  else if (choice !== 'denied') show();
</script>

<style>
  .consent {
    position: fixed; left: 1rem; right: 1rem; bottom: 1rem; z-index: 60;
    max-width: 40rem; margin-inline: auto;
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem;
    padding: 0.9rem 1rem;
    background: var(--panel2); border: 1px solid var(--line-bright);
    box-shadow: 0 14px 40px -12px rgba(0,0,0,0.9);
  }
  .consent.hidden { display: none; }
  .consent p { flex: 1 1 16rem; margin: 0; }
</style>
