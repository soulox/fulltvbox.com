---
import { Image } from 'astro:assets';
import type { WatchTitle } from '../lib/top10';
import { GENRES } from '../lib/genres';

interface Props {
  heading: string;
  items: WatchTitle[];
  showViews?: boolean;
  weeksSuffix?: string; // "in the Top 10" (weekly) or "in the Top 10 this period"
  ranked?: boolean; // false for lists that mix titles from different charts
}
const { heading, items, showViews = false, weeksSuffix = 'in the Top 10', ranked = true } = Astro.props;

const fmtViews = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : `${Math.round(n / 1e3)}K`);
const verdictClass = { watch: 'text-signal border-signal/40', skip: 'text-dim', depends: 'text-amber border-amber/40' };
const verdictLabel = { watch: 'Watch', skip: 'Skip', depends: 'Depends' };
const verdictHint = {
  watch: 'Reviews are broadly positive',
  skip: 'Reviews are broadly negative',
  depends: 'Mixed reviews, or good only for a specific taste; our take says who it suits',
};
// Movement since last week: [visible text, class, spoken/hover text]. No marker for "no change".
function movement(c: WatchTitle['change']): [string, string, string] | null {
  if (!c) return null;
  if (c.type === 'new') return ['New', 'text-signal border-signal/40', 'New in the Top 10 this week'];
  if (c.type === 'back') return ['Back', 'text-muted', 'Back in the Top 10 after time away'];
  if (c.by > 0) return [`▲ ${c.by}`, 'text-signal', `Up ${c.by} ${c.by === 1 ? 'place' : 'places'} from last week`];
  if (c.by < 0) return [`▼ ${-c.by}`, 'text-dim', `Down ${-c.by} ${c.by === -1 ? 'place' : 'places'} from last week`];
  return null;
}
---
<section>
  <h2 class="font-display font-800 text-2xl mb-4">{heading}</h2>
  {items.length === 0 ? (
    <p class="text-muted">No titles for this period yet.</p>
  ) : (
    <ol role="list" class="space-y-2">
      {items.map((t) => {
        const move = movement(t.change);
        return (
        <li class="bench-card frame px-4 py-3 flex items-start gap-4">
          {ranked && <span aria-hidden="true" class="font-display font-900 text-2xl text-signal leading-none w-8 shrink-0 text-right">{t.rank}</span>}
          <div class="flex-1 min-w-0">
            {t.image && (
              <Image
                src={t.image}
                alt={`${t.title} title art`}
                widths={[256, 389]}
                sizes="(min-width: 640px) 448px, 90vw"
                loading="lazy"
                class="w-full max-w-md aspect-video object-cover border border-line mb-3"
              />
            )}
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-display font-700 text-ink">{t.title}</span>
              {move && <span class={`chip !py-0 ${move[1]}`} title={move[2]}><span aria-hidden="true">{move[0]}</span><span class="sr-only">{move[2]}</span></span>}
              {t.verdict && <span class={`chip ${verdictClass[t.verdict.verdict]}`} title={verdictHint[t.verdict.verdict]}>{verdictLabel[t.verdict.verdict]}</span>}
            </div>
            {t.verdict && <p class="text-muted text-sm mt-1">{t.verdict.description}</p>}
            {t.verdict && (
              <p class="text-sm mt-1"><span class="label text-signal">Our take</span> <span class="text-ink/90">{t.verdict.take}</span></p>
            )}
            <div class="label text-dim mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1">
              {t.verdict?.genres.map((g) => <span class="chip !py-0 !text-[0.65rem]">{GENRES[g]}</span>)}
              <span>
                {showViews && t.views !== undefined && `${fmtViews(t.views)} views · `}
                {t.weeksInTop10} {t.weeksInTop10 === 1 ? 'week' : 'weeks'} {weeksSuffix}
              </span>
            </div>
          </div>
        </li>
        );
      })}
    </ol>
  )}
</section>
