---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import { getCollection } from 'astro:content';
import { getDealsByDevice } from '../../lib/deals';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map(review => ({
    params: { slug: review.slug },
    props: { review, allReviews: reviews },
  }));
}

const { review, allReviews } = Astro.props;
const { Content } = await review.render();

const deal = (await getDealsByDevice()).get(review.slug);

const related = allReviews
  .filter(r => r.slug !== review.slug)
  .map(r => ({
    r,
    score: r.data.tags.filter((t: string) => review.data.tags.includes(t)).length,
  }))
  .sort((a, b) => b.score - a.score || new Date(b.r.data.publishDate).getTime() - new Date(a.r.data.publishDate).getTime())
  .slice(0, 3)
  .map(({ r }) => r);
---
<ReviewLayout
  title={review.data.title}
  description={review.data.description}
  publishDate={review.data.publishDate}
  rating={review.data.rating}
  affiliate={review.data.affiliate}
  updatedDate={review.data.updatedDate}
  price={review.data.price}
  specs={review.data.specs}
  deal={deal}
  faq={review.data.faq}
  author={review.data.author}
  ogImage={`/og/reviews/${review.slug}.png`}
>
  <Content />
  <div slot="related">
    {related.length > 0 && (
      <section class="max-w-3xl mx-auto px-4 pb-20">
        <div class="smpte-bars h-px w-full mb-8 opacity-50"></div>
        <span class="label text-signal">// Also on the bench</span>
        <h2 class="font-display font-800 text-2xl mt-1 mb-6">Related Reviews</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          {related.map(r => (
            <a href={`/reviews/${r.slug}`} class="bench-card frame group p-4 flex flex-col">
              <div class="flex items-center justify-between mb-2">
                <span class="font-display font-900 text-lg text-signal leading-none">{r.data.rating.toFixed(1)}</span>
                <span class="label text-dim">/ 5.0</span>
              </div>
              <h3 class="font-display font-700 text-sm text-ink group-hover:text-signal transition-colors leading-snug flex-1">
                {r.data.title.replace(/ Review.*$/i, '').trim()}
              </h3>
              <p class="text-muted text-xs mt-2 line-clamp-2">{r.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</ReviewLayout>
