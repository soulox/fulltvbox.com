---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { getCollection } from 'astro:content';
import { getDealsByDevice } from '../../lib/deals';
import { buildLinkGraph } from '../../lib/links';
import { relatedReviews } from '../../lib/reviews';

export async function getStaticPaths() {
  const [reviews, guides] = await Promise.all([
    getCollection('reviews'),
    getCollection('guides'),
  ]);
  return reviews.map(review => ({
    params: { slug: review.slug },
    props: { review, allReviews: reviews, allGuides: guides },
  }));
}

const { review, allReviews, allGuides } = Astro.props;
const { Content } = await review.render();

const deal = (await getDealsByDevice()).get(review.slug);

const related = relatedReviews(review, allReviews).map(r => ({
  href: `/reviews/${r.slug}`,
  title: r.data.title.replace(/ Review.*$/i, '').trim(),
  description: r.data.description,
  rating: r.data.rating,
}));

const guideBySlug = new Map(allGuides.map(g => [g.slug, g]));
const featuredInGuides = buildLinkGraph(allGuides, allReviews)
  .guidesFeaturingReview(review.slug)
  .map(slug => guideBySlug.get(slug))
  .filter((g): g is NonNullable<typeof g> => !!g)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3)
  .map(g => ({ href: `/guides/${g.slug}`, title: g.data.title, description: g.data.description }));
---
<ReviewLayout
  title={review.data.title}
  description={review.data.description}
  publishDate={review.data.publishDate}
  rating={review.data.rating}
  affiliate={review.data.affiliate}
  updatedDate={review.data.updatedDate}
  price={review.data.price}
  specs={review.data.specs}
  deal={deal}
  faq={review.data.faq}
  author={review.data.author}
  ogImage={`/og/reviews/${review.slug}.png`}
>
  <Content />
  {related.length > 0 && (
    <RelatedLinks slot="related" items={related} heading="Related Reviews" label="// Also on the bench" />
  )}
  {featuredInGuides.length > 0 && (
    <RelatedLinks slot="related" items={featuredInGuides} heading="Guides featuring this device" label="// In our guides" />
  )}
</ReviewLayout>
