---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { freshness, latestDate } from '../../lib/freshness';

const reviews = await getCollection('reviews');
const sorted = reviews.sort((a, b) =>
  new Date(latestDate(b.data.publishDate, b.data.updatedDate)).getTime() -
  new Date(latestDate(a.data.publishDate, a.data.updatedDate)).getTime()
);

const allTags = [...new Set(reviews.flatMap(r => r.data.tags))].sort();

const site = Astro.site;
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'TV Box Reviews',
  itemListElement: sorted.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/reviews/${r.slug}`, site).href,
    name: r.data.title,
  })),
};

function meter(rating: number) {
  return Array.from({ length: 5 }, (_, i) => {
    if (rating >= i + 1) return 'on';
    if (rating >= i + 0.5) return 'half';
    return 'off';
  });
}
---
<BaseLayout title="TV Box Reviews" description="All TV box reviews on FullTVBox — ranked, rated, and honestly written.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <div class="max-w-5xl mx-auto px-4 py-14">
    <span class="label text-signal">// Channel 02</span>
    <h1 class="font-display font-900 text-4xl sm:text-5xl tracking-tight mt-1 mb-2">TV Box Reviews</h1>
    <p class="text-muted mb-8">Every device on the bench, newest first.</p>

    <!-- Tag filters -->
    <div class="flex flex-wrap gap-2 mb-10">
      <button data-tag="" class="tag-btn is-on">All</button>
      {allTags.map(tag => (
        <button data-tag={tag} class="tag-btn">{tag}</button>
      ))}
    </div>

    <div id="reviews-grid" class="grid sm:grid-cols-2 gap-5">
      {sorted.map(review => (
        <a
          href={`/reviews/${review.slug}`}
          data-tags={review.data.tags.join(',')}
          class="review-card bench-card frame group p-6 flex flex-col"
        >
          <div class="flex items-start justify-between mb-4">
            <div class="flex flex-wrap gap-1.5">
              {freshness(review.data.publishDate, review.data.updatedDate) === 'updated' && <span class="chip text-scope border-scope/40">◆ UPDATED</span>}
              {freshness(review.data.publishDate, review.data.updatedDate) === 'new' && <span class="chip text-signal border-signal/40">◆ NEW</span>}
              {review.data.tags.slice(0, 2).map(tag => <span class="chip">{tag}</span>)}
            </div>
            <span class="font-display font-900 text-2xl text-signal leading-none shrink-0">{review.data.rating.toFixed(1)}</span>
          </div>
          <h2 class="font-display font-700 text-lg leading-snug text-ink group-hover:text-signal transition-colors mb-2 flex-1">
            {review.data.title.replace(/ Review.*$/i, '').trim()}
          </h2>
          <p class="text-muted text-sm line-clamp-2 mb-5">{review.data.description}</p>
          <div class="flex items-center justify-between">
            <div class="meter">
              {meter(review.data.rating).map(s => <span class={`seg ${s}`}></span>)}
            </div>
            <time class="label text-dim">
              {new Date(review.data.publishDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
            </time>
          </div>
        </a>
      ))}
    </div>

    <p id="no-results" class="hidden text-dim text-center py-12 label">// No reviews found for this input.</p>
  </div>

  <style>
    .tag-btn {
      font-family: "IBM Plex Mono", monospace; font-size: 0.7rem; text-transform: uppercase;
      letter-spacing: 0.06em; color: var(--muted); background: var(--panel);
      border: 1px solid var(--line); padding: 0.4rem 0.8rem; transition: all 0.16s; cursor: pointer;
    }
    .tag-btn:hover { color: var(--ink); border-color: var(--line-bright); }
    .tag-btn.is-on { color: #0a1206; background: var(--signal); border-color: var(--signal); }
  </style>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const initialTag = params.get('tag') ?? '';

  function applyFilter(tag: string) {
    const cards = document.querySelectorAll<HTMLElement>('.review-card');
    const buttons = document.querySelectorAll<HTMLElement>('.tag-btn');
    let visible = 0;

    cards.forEach(card => {
      const tags = card.dataset.tags ?? '';
      const match = !tag || tags.split(',').includes(tag);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    buttons.forEach(btn => btn.classList.toggle('is-on', btn.dataset.tag === tag));

    const noResults = document.getElementById('no-results');
    if (noResults) noResults.classList.toggle('hidden', visible > 0);
  }

  applyFilter(initialTag);
  document.querySelectorAll<HTMLElement>('.tag-btn').forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.tag ?? ''));
  });
</script>
