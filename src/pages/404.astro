---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="This page doesn't exist.">
  <div class="max-w-xl mx-auto px-4 py-28 text-center">
    <div class="panel frame inline-block px-10 py-10 relative overflow-hidden">
      <div class="absolute inset-0 smpte-bars opacity-[0.06]"></div>
      <div class="relative">
        <div class="label text-signal mb-4 flex items-center justify-center gap-2">
          <span class="tally tally-sm"></span> NO SIGNAL
        </div>
        <div class="font-display font-900 text-7xl text-ink mb-3 glitch">404</div>
        <h1 class="font-display font-700 text-xl text-ink mb-2">Channel not found</h1>
        <p class="text-muted text-sm mb-8">That page doesn't exist or may have moved off-air.</p>
        <div class="flex gap-3 justify-center flex-wrap">
          <a href="/" class="btn-signal">Go Home</a>
          <a href="/reviews" class="btn-ghost">Browse Reviews</a>
        </div>
      </div>
    </div>
  </div>

  <style>
    .glitch { text-shadow: 2px 0 var(--scope), -2px 0 var(--magenta); animation: glitch 3s steps(1) infinite; }
    @keyframes glitch {
      0%, 92%, 100% { text-shadow: 2px 0 var(--scope), -2px 0 var(--magenta); }
      94% { text-shadow: -3px 0 var(--scope), 3px 0 var(--magenta); }
      96% { text-shadow: 3px 0 var(--magenta), -3px 0 var(--scope); }
    }
    @media (prefers-reduced-motion: reduce) { .glitch { animation: none; } }
  </style>
</BaseLayout>
