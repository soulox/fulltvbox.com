---
import BaseLayout from '../layouts/BaseLayout.astro';
import CostCalculator from '../components/CostCalculator.astro';
import { getCollection } from 'astro:content';
import { getServices } from '../lib/services';
import { getLiveDeals } from '../lib/deals';

const reviews = await getCollection('reviews');
const boxes = [...reviews].sort((a, b) => b.data.rating - a.data.rating).slice(0, 3);
const services = (await getServices()).filter((s) => s.featured).slice(0, 6);
const deals = (await getLiveDeals()).slice(0, 3);
---
<BaseLayout title="Cut the Cord in 2026" description="Everything you need to ditch cable in 2026: a streaming cost calculator, the best TV boxes, top services compared, and live deals — in one place.">
  <!-- hero -->
  <section class="max-w-6xl mx-auto px-4 pt-16 sm:pt-24 pb-10" data-pagefind-body>
    <div class="flex items-center gap-3 mb-6">
      <span class="tally tally-sm"></span>
      <span class="label text-signal">// Cut the Cord</span>
      <span class="h-px flex-1 bg-line"></span>
    </div>
    <h1 class="font-display font-900 leading-[0.95] tracking-tight text-[2.8rem] sm:text-[4rem] text-ink max-w-3xl">
      Ditch cable.<br /><span class="text-signal glow-text">Keep</span> what you watch.
    </h1>
    <p class="text-muted text-lg mt-6 max-w-xl leading-relaxed">
      Streaming was supposed to be cheaper than cable. Stack enough services and it isn't.
      Total your bill, pick the right box, and catch the deals — all in one place.
    </p>
  </section>

  <!-- calculator -->
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex items-end justify-between mb-7">
      <div>
        <span class="label text-signal">// 01 — Total your stack</span>
        <h2 class="font-display font-800 text-3xl mt-1">What are you really paying?</h2>
      </div>
      <a href="/cost-calculator" class="hidden sm:inline label text-muted hover:text-signal transition-colors">Full calculator →</a>
    </div>
    <CostCalculator />
  </section>

  <!-- recommended boxes -->
  <section class="border-y border-line bg-panel/30 py-14">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-end justify-between mb-7">
        <div>
          <span class="label text-signal">// 02 — Hardware</span>
          <h2 class="font-display font-800 text-3xl mt-1">Start with the right box</h2>
        </div>
        <a href="/reviews" class="label text-muted hover:text-signal transition-colors">All reviews →</a>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        {boxes.map((b) => (
          <a href={`/reviews/${b.slug}`} class="bench-card frame group p-6 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="chip">{b.data.tags[0]}</span>
              <span class="font-display font-900 text-2xl text-signal leading-none">{b.data.rating.toFixed(1)}</span>
            </div>
            <h3 class="font-display font-700 text-ink group-hover:text-signal transition-colors leading-snug">
              {b.data.title.replace(/ Review.*$/i, '').trim()}
            </h3>
            {b.data.price && <div class="label text-dim mt-2">from ${b.data.price}</div>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- popular services -->
  <section class="max-w-6xl mx-auto px-4 py-14">
    <div class="flex items-end justify-between mb-7">
      <div>
        <span class="label text-signal">// 03 — Services</span>
        <h2 class="font-display font-800 text-3xl mt-1">Pick your channels</h2>
      </div>
      <a href="/streaming-services" class="label text-muted hover:text-signal transition-colors">All services →</a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-line border border-line">
      {services.map((s) => (
        <a href="/streaming-services" class="group bg-panel hover:bg-panel2 transition-colors px-5 py-5">
          <div class="font-display font-700 text-ink group-hover:text-signal transition-colors">{s.name}</div>
          <div class="label text-dim mt-1">{s.monthlyPrice === 0 ? 'Free' : `$${s.monthlyPrice}/mo`}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- deals + guide -->
  <section class="border-t border-line bg-panel/30 py-14">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-2 gap-8">
      <div>
        <span class="label text-signal">// 04 — Deals</span>
        <h2 class="font-display font-800 text-2xl mt-1 mb-5">Live price drops</h2>
        <div class="space-y-3">
          {deals.map((d) => (
            <a href={d.url} target="_blank" rel="noopener sponsored" class="bench-card frame group flex items-center gap-4 px-4 py-3">
              <div class="flex-1 min-w-0">
                <div class="font-display font-700 text-ink group-hover:text-signal transition-colors truncate">{d.name}</div>
                <div class="label text-dim mt-0.5">{d.retailer}</div>
              </div>
              <div class="text-right shrink-0">
                <span class="font-display font-900 text-xl text-signal leading-none">${d.price}</span>
                {d.wasPrice && <span class="font-mono text-xs text-dim line-through ml-1.5">${d.wasPrice}</span>}
              </div>
            </a>
          ))}
        </div>
        <a href="/deals" class="inline-block mt-4 label text-muted hover:text-signal transition-colors">All deals →</a>
      </div>

      <div class="panel frame p-8 flex flex-col justify-center">
        <span class="label text-signal mb-3">// Read next</span>
        <h2 class="font-display font-800 text-2xl text-ink mb-3">Is cutting the cord still worth it in 2026?</h2>
        <p class="text-muted mb-6 leading-relaxed">
          With live-TV streaming creeping past $80/month, the math isn't as obvious as it used to be.
          Here's how to make sure you actually come out ahead.
        </p>
        <a href="/guides/is-cutting-the-cord-worth-it-2026" class="btn-ghost self-start">Read the guide →</a>
      </div>
    </div>
  </section>
</BaseLayout>
