---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { tutorialImage } from '../../lib/tutorialImages';

const tutorials = await getCollection('tutorials');
const sorted = tutorials.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

// Most-used tags first, so the filter row stays short as the collection grows.
const tagCounts = new Map<string, number>();
for (const tag of tutorials.flatMap(t => t.data.tags)) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const byUse = [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([tag]) => tag);
// Up to MAIN_MAX of the most-used tags (each on 3+ tutorials) stay visible: about two rows
// on desktop. The rest wait behind the toggle.
const MAIN_MIN = 3;
const MAIN_MAX = 14;
const mainTags = byUse.filter(tag => tagCounts.get(tag)! >= MAIN_MIN).slice(0, MAIN_MAX);
const moreTags = byUse.filter(tag => !mainTags.includes(tag)).sort();

const difficultyColor = {
  beginner: 'text-signal border-signal/40',
  intermediate: 'text-amber border-amber/40',
  advanced: 'text-magenta border-magenta/40',
};

const site = Astro.site;
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Raspberry Pi & Device Tutorials',
  itemListElement: sorted.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/tutorials/${t.slug}`, site).href,
    name: t.data.title,
  })),
};
---
<BaseLayout title="Tutorials" description="Step-by-step tutorials for Raspberry Pi, new gadgets, home automation, and more.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <div class="max-w-5xl mx-auto px-4 py-14">
    <span class="label text-signal">// Channel 05</span>
    <h1 class="font-display font-900 text-4xl sm:text-5xl tracking-tight mt-1 mb-2">Tutorials</h1>
    <p class="text-muted mb-8">Raspberry Pi, home media, smart home and local AI — hands-on builds for tinkerers.</p>

    <!-- Tag filters -->
    <!-- On phones the main topics scroll sideways in one row; from sm up they wrap. -->
    <div class="mb-10">
      <div class="tag-row flex gap-2 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 sm:pb-0 sm:flex-wrap sm:overflow-visible">
        <button data-tag="" class="tag-btn is-on">All</button>
        {mainTags.map(tag => (
          <button data-tag={tag} class="tag-btn">{tag} <span class="tag-count">{tagCounts.get(tag)}</span></button>
        ))}
        {moreTags.length > 0 && (
          <button id="more-tags-toggle" type="button" class="tag-more" aria-expanded="false" aria-controls="more-tags">
            + {moreTags.length} more
          </button>
        )}
      </div>
      {moreTags.length > 0 && (
        <div id="more-tags" class="hidden flex flex-wrap gap-2 mt-2">
          {moreTags.map(tag => (
            <button data-tag={tag} class="tag-btn">{tag}</button>
          ))}
        </div>
      )}
    </div>

    <div id="tutorials-grid" class="grid sm:grid-cols-2 gap-5">
      {sorted.map(tutorial => (
        <a
          href={`/tutorials/${tutorial.slug}`}
          data-tags={tutorial.data.tags.join(',')}
          class="tutorial-card bench-card frame group p-6 flex flex-col"
        >
          {tutorialImage(tutorial.slug) && (
            <Image
              src={tutorialImage(tutorial.slug)!.src}
              alt={tutorialImage(tutorial.slug)!.alt}
              widths={[400, 800]}
              sizes="(min-width: 640px) 400px, 100vw"
              format="webp"
              loading="lazy"
              class="-mx-6 -mt-6 mb-5 w-[calc(100%+3rem)] max-w-none aspect-[16/9] object-cover border-b border-line"
            />
          )}
          <div class="flex items-center gap-2 mb-4 flex-wrap">
            <span class={`chip ${difficultyColor[tutorial.data.difficulty]}`}>
              ◆ {tutorial.data.difficulty}
            </span>
            <span class="chip">⏱ {tutorial.data.duration}</span>
          </div>
          <h2 class="font-display font-700 text-lg leading-snug text-ink group-hover:text-signal transition-colors mb-2 flex-1">
            {tutorial.data.title}
          </h2>
          <p class="text-muted text-sm line-clamp-2 mb-5">{tutorial.data.description}</p>
          <div class="flex items-center justify-between">
            <div class="flex flex-wrap gap-1.5">
              {tutorial.data.tags.slice(0, 2).map(tag => <span class="chip">{tag}</span>)}
            </div>
            <time class="label text-dim shrink-0">
              {new Date(tutorial.data.publishDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
            </time>
          </div>
        </a>
      ))}
    </div>

    <p id="no-results" class="hidden text-dim text-center py-12 label">// No tutorials found for this input.</p>
  </div>

  <style>
    .tag-btn {
      font-family: "IBM Plex Mono", monospace; font-size: 0.7rem; text-transform: uppercase;
      letter-spacing: 0.06em; color: var(--muted); background: var(--panel);
      border: 1px solid var(--line); padding: 0.4rem 0.8rem; transition: all 0.16s; cursor: pointer;
    }
    .tag-btn:hover { color: var(--ink); border-color: var(--line-bright); }
    .tag-btn.is-on { color: #0a1206; background: var(--signal); border-color: var(--signal); }
    .tag-row > * { flex-shrink: 0; white-space: nowrap; }
    .tag-row { scrollbar-width: thin; }
    .tag-count { opacity: 0.6; margin-left: 0.15rem; }
    .tag-more {
      font-family: "IBM Plex Mono", monospace; font-size: 0.7rem; text-transform: uppercase;
      letter-spacing: 0.06em; color: var(--signal); background: transparent;
      border: 1px dashed var(--line-bright); padding: 0.4rem 0.8rem; cursor: pointer;
    }
    .tag-more:hover { border-color: var(--signal); }
  </style>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const initialTag = params.get('tag') ?? '';

  function applyFilter(tag: string) {
    const cards = document.querySelectorAll<HTMLElement>('.tutorial-card');
    const buttons = document.querySelectorAll<HTMLElement>('.tag-btn');
    let visible = 0;

    cards.forEach(card => {
      const tags = card.dataset.tags ?? '';
      const match = !tag || tags.split(',').includes(tag);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    buttons.forEach(btn => btn.classList.toggle('is-on', btn.dataset.tag === tag));

    const noResults = document.getElementById('no-results');
    if (noResults) noResults.classList.toggle('hidden', visible > 0);
  }

  const moreToggle = document.getElementById('more-tags-toggle');
  const moreTags = document.getElementById('more-tags');
  function showMoreTags(open: boolean) {
    if (!moreToggle || !moreTags) return;
    moreTags.classList.toggle('hidden', !open);
    moreToggle.setAttribute('aria-expanded', String(open));
    moreToggle.textContent = open ? '− fewer' : `+ ${moreTags.children.length} more`;
  }
  moreToggle?.addEventListener('click', () => showMoreTags(moreTags?.classList.contains('hidden') ?? false));

  // A link to a less-used tag (?tag=frigate) opens the full list so the active tag is visible.
  if (initialTag && moreTags?.querySelector(`[data-tag="${CSS.escape(initialTag)}"]`)) showMoreTags(true);
  applyFilter(initialTag);
  document.querySelectorAll<HTMLElement>('.tag-btn').forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.tag ?? ''));
  });
</script>
