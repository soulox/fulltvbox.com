---
import TutorialLayout from '../../layouts/TutorialLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { getCollection } from 'astro:content';
import { promptsForPage, toLink } from '../../lib/prompts';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials');
  return tutorials.map(tutorial => ({
    params: { slug: tutorial.slug },
    props: { tutorial, allTutorials: tutorials },
  }));
}

const { tutorial, allTutorials } = Astro.props;
const { Content } = await tutorial.render();
const promptLinks = (await promptsForPage(tutorial.slug)).map(toLink);

const related = allTutorials
  .filter(t => t.slug !== tutorial.slug)
  .map(t => ({
    t,
    score: t.data.tags.filter((tag: string) => tutorial.data.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.score - a.score || new Date(b.t.data.publishDate).getTime() - new Date(a.t.data.publishDate).getTime())
  .slice(0, 3)
  .map(({ t }) => ({ href: `/tutorials/${t.slug}`, title: t.data.title, description: t.data.description }));
---
<TutorialLayout
  title={tutorial.data.title}
  description={tutorial.data.description}
  publishDate={tutorial.data.publishDate}
  updatedDate={tutorial.data.updatedDate}
  difficulty={tutorial.data.difficulty}
  duration={tutorial.data.duration}
  tags={tutorial.data.tags}
  image={tutorial.data.image}
  author={tutorial.data.author}
  ogImage={`/og/tutorials/${tutorial.slug}.png`}
>
  <Content />
  <RelatedLinks slot="related" items={related} heading="More Tutorials" label="// Next build" />
  <RelatedLinks slot="related" items={promptLinks} heading="AI prompts for this" label="// Prompt library" moreHref="/ai/prompts" moreText="All prompts" />
</TutorialLayout>
