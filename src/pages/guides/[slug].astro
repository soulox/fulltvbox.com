---
import GuideLayout from '../../layouts/GuideLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import DeviceCTA from '../../components/DeviceCTA.astro';
import { getCollection } from 'astro:content';
import { relatedGuides, guideCategoryLabel } from '../../lib/guides';
import { buildLinkGraph } from '../../lib/links';
import { getDealsByDevice } from '../../lib/deals';

export async function getStaticPaths() {
  const [guides, reviews] = await Promise.all([
    getCollection('guides'),
    getCollection('reviews'),
  ]);
  return guides.map(guide => ({
    params: { slug: guide.slug },
    props: { guide, allGuides: guides, allReviews: reviews },
  }));
}

const { guide, allGuides, allReviews } = Astro.props;
const { Content } = await guide.render();

const related = relatedGuides(guide, allGuides).map(g => ({
  href: `/guides/${g.slug}`,
  title: g.data.title,
  description: g.data.description,
}));

const graph = buildLinkGraph(allGuides, allReviews);
const reviewBySlug = new Map(allReviews.map(r => [r.slug, r]));
const dealsByDevice = await getDealsByDevice();
const devices = graph
  .reviewsMentionedInGuide(guide.slug)
  .map(slug => reviewBySlug.get(slug))
  .filter((r): r is NonNullable<typeof r> => !!r)
  .slice(0, 6)
  .map(r => {
    const deal = dealsByDevice.get(r.slug);
    return {
      href: `/reviews/${r.slug}`,
      name: r.data.title.replace(/ Review.*$/i, '').trim(),
      rating: r.data.rating,
      price: r.data.price,
      affiliate: r.data.affiliate,
      deal: deal
        ? { url: deal.url, price: deal.price, wasPrice: deal.wasPrice, retailer: deal.retailer, discountPct: deal.discountPct }
        : undefined,
    };
  });

const categoryLabel = guideCategoryLabel(guide.data.category);
---
<GuideLayout
  title={guide.data.title}
  description={guide.data.description}
  publishDate={guide.data.publishDate}
  updatedDate={guide.data.updatedDate}
  image={guide.data.image}
  faq={guide.data.faq}
  author={guide.data.author}
  ogImage={`/og/guides/${guide.slug}.png`}
>
  <Content />
  {devices.length > 0 && <DeviceCTA slot="related" items={devices} />}
  <RelatedLinks
    slot="related"
    items={related}
    heading="More Guides"
    label="// Keep reading"
    moreHref={`/guides/category/${guide.data.category}`}
    moreText={`All ${categoryLabel}`}
  />
</GuideLayout>
