---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLiveDeals } from '../lib/deals';
import { freshness, latestDate } from '../lib/freshness';

const allReviews = await getCollection('reviews');
const featured = allReviews.filter(r => r.data.featured).slice(0, 3);
const recent = [...allReviews].sort((a, b) =>
  new Date(latestDate(b.data.publishDate, b.data.updatedDate)).getTime() -
  new Date(latestDate(a.data.publishDate, a.data.updatedDate)).getTime()
).slice(0, 6);

const deals = (await getLiveDeals()).slice(0, 3);

// hero "monitor" feed = highest-rated featured (or highest-rated overall)
const top = [...allReviews].sort((a, b) => b.data.rating - a.data.rating)[0];

// ticker feed
const ticker = [...allReviews]
  .sort((a, b) => b.data.rating - a.data.rating)
  .slice(0, 8)
  .map(r => ({
    name: r.data.title.replace(/ Review.*$/i, '').replace(/\s*\(.*\)\s*$/, '').trim(),
    rating: r.data.rating,
  }));

const totalReviews = allReviews.length;

// 1–5 rating → 5 meter segments
function meter(rating: number) {
  return Array.from({ length: 5 }, (_, i) => {
    if (rating >= i + 1) return 'on';
    if (rating >= i + 0.5) return 'half';
    return 'off';
  });
}

const fresh = (r: typeof allReviews[number]) => freshness(r.data.publishDate, r.data.updatedDate);

const site = Astro.site;
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FullTVBox',
  url: site?.href,
  logo: { '@type': 'ImageObject', url: new URL('/og-default.png', site).href },
  description: 'Independent TV box reviews, head-to-head comparisons, and setup guides — tested on the bench, rated without mercy.',
};
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FullTVBox',
  url: site?.href,
  publisher: { '@type': 'Organization', name: 'FullTVBox' },
};
---
<BaseLayout
  title="TV Box Reviews & Comparisons"
  description="Independent TV box and streaming-stick reviews, head-to-head comparisons, live deals, and setup guides — tested on the bench and rated without mercy."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([orgSchema, siteSchema])} />
  </Fragment>

  <!-- ─── HERO ──────────────────────────────────────────────── -->
  <section class="relative max-w-6xl mx-auto px-4 pt-16 sm:pt-24 pb-12">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 items-center">

      <!-- left: headline -->
      <div class="reveal">
        <div class="flex items-center gap-3 mb-6">
          <span class="label text-signal">// AV Hardware Lab — Est. 2025</span>
          <span class="h-px flex-1 bg-line"></span>
        </div>

        <h1 class="font-display font-900 leading-[0.92] tracking-tight text-[3.1rem] sm:text-[4.6rem] text-ink">
          TESTED ON<br />
          THE BENCH.<br />
          <span class="text-signal glow-text">RATED</span> WITHOUT<br />
          MERCY.
        </h1>

        <p class="text-muted text-lg mt-7 max-w-md leading-relaxed">
          Every streaming box and stick runs two weeks of daily use on our test bench —
          boot speed, 4K HDR, Atmos passthrough, Wi-Fi, the lot. No freebies. No bias.
        </p>

        <div class="flex flex-wrap gap-3 mt-9">
          <a href="/reviews" class="btn-signal">Browse Reviews →</a>
          <a href="/best-picks" class="btn-ghost">Best Picks 2025</a>
        </div>

        <div class="flex items-center gap-7 mt-10 pt-7 border-t border-line">
          <div>
            <div class="font-display font-900 text-2xl text-ink">{totalReviews}</div>
            <div class="label mt-0.5">Devices tested</div>
          </div>
          <div>
            <div class="font-display font-900 text-2xl text-ink">14<span class="text-dim text-base font-mono">days</span></div>
            <div class="label mt-0.5">Min. test cycle</div>
          </div>
          <div>
            <div class="font-display font-900 text-2xl text-signal">0</div>
            <div class="label mt-0.5">Sponsored ranks</div>
          </div>
        </div>
      </div>

      <!-- right: faux broadcast monitor -->
      {top && (
        <a href={`/reviews/${top.slug}`} class="monitor frame reveal reveal-2 group block">
          <div class="monitor-bezel">
            <div class="monitor-screen">
              <!-- header strip -->
              <div class="flex items-center justify-between mb-5">
                <span class="label text-signal flex items-center gap-2">
                  <span class="tally tally-sm"></span> REC · TOP RATED
                </span>
                <span class="label">INPUT · HDMI 1</span>
              </div>

              <!-- device name -->
              <div class="label text-dim mb-1">Now testing</div>
              <h2 class="font-display font-800 text-2xl sm:text-3xl leading-tight text-ink mb-1 group-hover:text-signal transition-colors">
                {top.data.title.replace(/ Review.*$/i, '').trim()}
              </h2>
              <p class="text-muted text-sm mb-6 line-clamp-2">{top.data.description}</p>

              <!-- score readout -->
              <div class="flex items-end justify-between mb-5">
                <div>
                  <div class="label mb-2">Bench score</div>
                  <div class="meter">
                    {meter(top.data.rating).map(s => <span class={`seg ${s}`}></span>)}
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-display font-900 text-5xl text-signal leading-none glow-text">{top.data.rating.toFixed(1)}</div>
                  <div class="label mt-1">/ 5.0 rated</div>
                </div>
              </div>

              <!-- mono spec ticks -->
              <div class="grid grid-cols-3 gap-px bg-line border border-line">
                {[['SIGNAL','LOCKED'],['4K HDR','PASS'],['ATMOS','PASS']].map(([k,v]) => (
                  <div class="bg-panel px-3 py-2">
                    <div class="label text-[0.58rem]">{k}</div>
                    <div class="font-mono text-xs text-signal mt-0.5">{v}</div>
                  </div>
                ))}
              </div>

              <div class="smpte-bars h-1.5 w-full mt-5 opacity-80"></div>
            </div>
          </div>
        </a>
      )}
    </div>
  </section>

  <!-- ─── TICKER ────────────────────────────────────────────── -->
  <section class="border-y border-line bg-panel/40 overflow-hidden py-3" aria-hidden="true">
    <div class="ticker-track">
      {[0,1].map(() => (
        <div class="flex items-center">
          {ticker.map(t => (
            <span class="inline-flex items-center gap-2.5 px-6 font-mono text-sm">
              <span class="text-dim">◆</span>
              <span class="text-muted uppercase tracking-wide text-xs">{t.name}</span>
              <span class="text-signal font-semibold">{t.rating.toFixed(1)}</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ─── LIVE DEALS ────────────────────────────────────────── -->
  {deals.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 pt-16">
      <div class="flex items-end justify-between mb-6">
        <div class="flex items-center gap-3">
          <span class="tally tally-sm"></span>
          <div>
            <span class="label text-signal">// Live deals</span>
            <h2 class="font-display font-800 text-2xl mt-1">Price Drops Now</h2>
          </div>
        </div>
        <a href="/deals" class="label text-muted hover:text-signal transition-colors">All deals →</a>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        {deals.map(deal => {
          return (
            <a href={deal.url} target="_blank" rel="noopener sponsored" class="bench-card frame group p-5 flex flex-col">
              <div class="flex items-center justify-between mb-3">
                <span class="chip">{deal.retailer}</span>
                {deal.discountPct && <span class="font-mono text-xs font-semibold text-void bg-signal px-2 py-0.5">-{deal.discountPct}%</span>}
              </div>
              <div class="font-display font-700 text-ink leading-snug mb-3 flex-1 group-hover:text-signal transition-colors">{deal.name}</div>
              <div class="flex items-end gap-2">
                <span class="font-display font-900 text-2xl text-signal leading-none">${deal.price}</span>
                {deal.wasPrice && <span class="font-mono text-xs text-dim line-through mb-0.5">${deal.wasPrice}</span>}
                <span class="label text-dim ml-auto">Get deal →</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- ─── FEATURED ──────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 py-20">
    <div class="flex items-end justify-between mb-9">
      <div>
        <span class="label text-signal">// 01</span>
        <h2 class="font-display font-800 text-3xl mt-1">Featured Reviews</h2>
      </div>
      <a href="/reviews" class="hidden sm:inline label text-muted hover:text-signal transition-colors">All reviews →</a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {featured.map(review => (
        <a href={`/reviews/${review.slug}`} class="bench-card frame group p-6 flex flex-col">
          <div class="flex items-start justify-between mb-5">
            <div class="flex flex-wrap gap-1.5">
              {fresh(review) === 'updated' && <span class="chip text-scope border-scope/40">◆ UPDATED</span>}
              {fresh(review) === 'new' && <span class="chip text-signal border-signal/40">◆ NEW</span>}
              {review.data.tags.slice(0, 2).map(tag => <span class="chip">{tag}</span>)}
            </div>
            <div class="text-right shrink-0">
              <div class="font-display font-900 text-2xl text-signal leading-none">{review.data.rating.toFixed(1)}</div>
            </div>
          </div>
          <h3 class="font-display font-700 text-lg leading-snug text-ink group-hover:text-signal transition-colors mb-2">
            {review.data.title.replace(/ Review.*$/i, '').trim()}
          </h3>
          <p class="text-muted text-sm line-clamp-2 mb-5 flex-1">{review.data.description}</p>
          <div class="meter">
            {meter(review.data.rating).map(s => <span class={`seg ${s}`}></span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ─── CATEGORIES (input select) ─────────────────────────── -->
  <section class="border-y border-line bg-panel/30 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-9">
        <span class="label text-signal">// 02</span>
        <h2 class="font-display font-800 text-3xl mt-1">Select Input</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-line border border-line">
        {[
          { label: 'Android TV', code: 'IN-1', href: '/reviews?tag=android+tv' },
          { label: 'Budget Picks', code: 'IN-2', href: '/reviews?tag=budget' },
          { label: '4K Streaming', code: 'IN-3', href: '/reviews?tag=4k' },
          { label: 'Gaming Boxes', code: 'IN-4', href: '/reviews?tag=gaming' },
        ].map(cat => (
          <a href={cat.href} class="input-cell group bg-panel px-5 py-7">
            <span class="label text-dim group-hover:text-signal transition-colors">{cat.code}</span>
            <div class="font-display font-700 text-lg mt-3 text-ink group-hover:text-signal transition-colors">{cat.label}</div>
            <span class="block mt-3 text-dim font-mono text-xs group-hover:text-signal transition-colors">→ tune in</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── RECENT (test log) ─────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 py-20">
    <div class="flex items-end justify-between mb-9">
      <div>
        <span class="label text-signal">// 03</span>
        <h2 class="font-display font-800 text-3xl mt-1">Latest from the Bench</h2>
      </div>
      <a href="/reviews" class="label text-muted hover:text-signal transition-colors">View all →</a>
    </div>

    <div class="panel divide-y divide-line">
      {recent.map((review, i) => (
        <a href={`/reviews/${review.slug}`} class="log-row group flex items-center gap-4 px-5 py-4">
          <span class="font-mono text-xs text-dim w-7 shrink-0">{String(i + 1).padStart(2, '0')}</span>
          <div class="flex-1 min-w-0">
            <h3 class="font-display font-700 text-ink group-hover:text-signal transition-colors truncate flex items-center gap-2">
              {review.data.title.replace(/ Review.*$/i, '').trim()}
              {fresh(review) === 'updated' && <span class="chip text-scope border-scope/40 shrink-0">UPDATED</span>}
              {fresh(review) === 'new' && <span class="chip text-signal border-signal/40 shrink-0">NEW</span>}
            </h3>
            <time class="label text-dim block mt-0.5">
              {new Date(review.data.updatedDate ?? review.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })}
              {review.data.updatedDate && <span class="text-dim"> · updated</span>}
            </time>
          </div>
          <div class="hidden sm:block meter shrink-0">
            {meter(review.data.rating).map(s => <span class={`seg ${s}`}></span>)}
          </div>
          <span class="font-display font-900 text-xl text-signal w-12 text-right shrink-0">{review.data.rating.toFixed(1)}</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .monitor-bezel {
      background: linear-gradient(160deg, #1a2128, #0a0d11);
      border: 1px solid var(--line-bright);
      padding: 14px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 30px 70px -30px rgba(0,0,0,0.95);
    }
    .monitor-screen {
      background:
        radial-gradient(120% 100% at 50% 0%, rgba(168,232,77,0.05), transparent 60%),
        #080b0f;
      border: 1px solid #05070a;
      padding: 1.6rem;
      position: relative;
      overflow: hidden;
    }
    .monitor-screen::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0,0,0,0.22) 2px 3px);
    }
    .input-cell { transition: background 0.2s; }
    .input-cell:hover { background: var(--panel2); }
    .log-row { transition: background 0.18s, padding-left 0.18s; }
    .log-row:hover { background: var(--panel2); padding-left: 1.6rem; }

    .reveal { opacity: 0; transform: translateY(16px); animation: rise 0.7s cubic-bezier(0.2,0.7,0.2,1) forwards; }
    .reveal-2 { animation-delay: 0.14s; }
    @keyframes rise { to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .reveal { animation: none; opacity: 1; transform: none; } }
  </style>
</BaseLayout>
