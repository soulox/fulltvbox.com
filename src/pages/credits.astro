---
import BaseLayout from '../layouts/BaseLayout.astro';

// Image attributions. All product photos are from Wikimedia Commons under
// CC BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/).
const credits = [
  { device: 'Apple TV 4K (3rd Gen)', author: 'Dillan Payne', page: 'https://commons.wikimedia.org/w/index.php?curid=163985530' },
  { device: 'Chromecast with Google TV (4K)', author: 'Y2kcrazyjoker4', page: 'https://commons.wikimedia.org/w/index.php?curid=99000454' },
  { device: 'Amazon Fire TV Stick 4K Max', author: 'JulianVilla26', page: 'https://commons.wikimedia.org/w/index.php?curid=128957257' },
  { device: 'NVIDIA Shield TV Pro', author: '之乎', page: 'https://commons.wikimedia.org/w/index.php?curid=70264257' },
  { device: 'Roku Streaming Stick 4K', author: 'TaurusEmerald', page: 'https://commons.wikimedia.org/w/index.php?curid=147918601' },
  { device: 'Amazon Fire TV Cube', author: 'FASTILY', page: 'https://commons.wikimedia.org/w/index.php?curid=70657567' },
  { device: 'Xiaomi Mi Box S', author: 'TGspot.co.il', page: 'https://commons.wikimedia.org/w/index.php?curid=77663174' },
];
const LICENSE = 'https://creativecommons.org/licenses/by-sa/4.0/';
---
<BaseLayout title="Credits & Image Attribution" description="Image sources and licensing for product photography used on FullTVBox.">
  <div class="max-w-3xl mx-auto px-4 py-14">
    <span class="label text-signal">// Source — Attribution</span>
    <h1 class="font-display font-900 text-4xl sm:text-5xl tracking-tight mt-1 mb-4">Credits</h1>
    <p class="text-muted mb-3 leading-relaxed">
      Product photography on FullTVBox is sourced from Wikimedia Commons and used under the
      <a href={LICENSE} target="_blank" rel="noopener" class="text-signal border-b border-signal/30 hover:border-signal">Creative Commons Attribution-ShareAlike 4.0</a>
      license. Each photo is credited to its author below; images are unmodified except for resizing.
    </p>

    <div class="smpte-bars h-1 w-full my-9 opacity-60"></div>

    <div class="panel divide-y divide-line">
      {credits.map((c, i) => (
        <div class="flex items-center gap-4 px-5 py-4">
          <span class="font-mono text-xs text-dim w-7 shrink-0">{String(i + 1).padStart(2, '0')}</span>
          <div class="flex-1 min-w-0">
            <div class="font-display font-700 text-ink truncate">{c.device}</div>
            <div class="label text-dim mt-0.5">© {c.author} · CC BY-SA 4.0</div>
          </div>
          <a href={c.page} target="_blank" rel="noopener" class="label text-muted hover:text-signal transition-colors shrink-0">
            Source →
          </a>
        </div>
      ))}
    </div>

    <p class="label text-dim mt-8">
      Spotted an attribution error? Email <a href="mailto:hello@fulltvbox.com" class="text-muted hover:text-signal underline">hello@fulltvbox.com</a>.
    </p>
  </div>
</BaseLayout>
