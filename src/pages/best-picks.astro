---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const bestPicks = guides.find(g => g.slug === 'best-tv-box-2025');
const { Content } = bestPicks ? await bestPicks.render() : { Content: null };
---
<BaseLayout title="Best TV Boxes 2025" description="Our top TV box picks for every budget in 2025 — tested and ranked.">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-white mb-2">Best TV Boxes of 2025</h1>
    <p class="text-gray-400 mb-10">Tested and ranked — updated regularly.</p>
    {Content && (
      <div class="prose prose-invert prose-lg max-w-none
        prose-headings:font-bold prose-headings:text-white
        prose-p:text-gray-300 prose-li:text-gray-300
        prose-a:text-brand prose-a:no-underline hover:prose-a:underline
        prose-hr:border-gray-800">
        <Content />
      </div>
    )}
  </div>
</BaseLayout>
