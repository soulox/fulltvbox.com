---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  duration: string;
  tags: string[];
  image?: string;
}
const { title, description, publishDate, difficulty, duration, tags, image } = Astro.props;

const difficultyColor = {
  beginner: 'bg-green-800 text-green-200',
  intermediate: 'bg-yellow-800 text-yellow-200',
  advanced: 'bg-red-900 text-red-200',
};
---
<BaseLayout title={title} description={description} image={image}>

  <!-- Breadcrumbs -->
  <nav class="max-w-3xl mx-auto px-4 pt-6 text-sm text-gray-500 flex items-center gap-2">
    <a href="/" class="hover:text-white transition-colors">Home</a>
    <span>/</span>
    <a href="/tutorials" class="hover:text-white transition-colors">Tutorials</a>
    <span>/</span>
    <span class="text-gray-400 truncate">{title}</span>
  </nav>

  <article class="max-w-3xl mx-auto px-4 py-8">

    {image && (
      <img src={image} alt={title} class="w-full rounded-xl mb-8 object-cover max-h-72" />
    )}

    <div class="flex items-center gap-3 mb-4 flex-wrap">
      <span class={`text-xs font-bold px-2.5 py-1 rounded-full ${difficultyColor[difficulty]}`}>
        {difficulty.charAt(0).toUpperCase() + difficulty.slice(1)}
      </span>
      <span class="text-gray-500 text-sm">⏱ {duration}</span>
      <time class="text-gray-500 text-sm">
        {new Date(publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </div>

    <h1 class="text-3xl font-bold text-white mb-4">{title}</h1>
    <p class="text-gray-400 text-lg mb-6">{description}</p>

    <div class="flex flex-wrap gap-2 mb-10">
      {tags.map(tag => (
        <span class="text-xs bg-gray-800 text-gray-400 px-2.5 py-1 rounded-full">{tag}</span>
      ))}
    </div>

    <div class="prose prose-invert prose-lg max-w-none
      prose-headings:font-bold prose-headings:text-white
      prose-p:text-gray-300 prose-li:text-gray-300
      prose-a:text-brand prose-a:no-underline hover:prose-a:underline
      prose-hr:border-gray-800 prose-strong:text-white
      prose-code:text-brand prose-code:bg-gray-900 prose-code:px-1 prose-code:rounded
      prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-800">
      <slot />
    </div>
  </article>
</BaseLayout>
