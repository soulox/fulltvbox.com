---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  duration: string;
  tags: string[];
  image?: string;
}
const { title, description, publishDate, difficulty, duration, tags, image } = Astro.props;

const difficultyColor = {
  beginner: 'text-signal border-signal/40',
  intermediate: 'text-amber border-amber/40',
  advanced: 'text-magenta border-magenta/40',
};
---
<BaseLayout title={title} description={description} image={image}>
  <!-- Breadcrumbs -->
  <nav class="max-w-3xl mx-auto px-4 pt-8 label flex items-center gap-2">
    <a href="/" class="hover:text-signal transition-colors">Home</a>
    <span class="text-line-bright">/</span>
    <a href="/tutorials" class="hover:text-signal transition-colors">Tutorials</a>
    <span class="text-line-bright">/</span>
    <span class="text-muted truncate">{title}</span>
  </nav>

  <article class="max-w-3xl mx-auto px-4 py-8">
    {image && (
      <img src={image} alt={title} class="w-full mb-8 object-cover max-h-72 border border-line" onerror="this.style.display='none';" />
    )}

    <div class="label mb-3 flex items-center gap-2">
      <span class="text-signal">TUTORIAL</span>
      <span class="text-line-bright">·</span>
      <time>{new Date(publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
    </div>

    <h1 class="font-display font-900 text-4xl sm:text-5xl leading-[0.95] tracking-tight text-ink mb-4">{title}</h1>
    <p class="text-muted text-lg mb-6 leading-relaxed">{description}</p>

    <div class="flex items-center gap-2.5 mb-8 flex-wrap">
      <span class={`chip ${difficultyColor[difficulty]}`}>
        ◆ {difficulty}
      </span>
      <span class="chip">⏱ {duration}</span>
      {tags.map(tag => <span class="chip">{tag}</span>)}
    </div>

    <div class="smpte-bars h-1 w-full mb-10 opacity-60"></div>

    <div class="prose prose-invert prose-lg max-w-none prose-bench
      prose-headings:font-display prose-headings:text-ink
      prose-p:text-ink/85 prose-li:text-ink/85 prose-img:border prose-img:border-line
      prose-pre:bg-[#080b0f] prose-pre:border prose-pre:border-line">
      <slot />
    </div>
  </article>
</BaseLayout>
