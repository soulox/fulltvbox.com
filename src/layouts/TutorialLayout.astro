---
import BaseLayout from './BaseLayout.astro';
import { freshness } from '../lib/freshness';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  updatedDate?: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  duration: string;
  tags: string[];
  image?: string;
  ogImage?: string;
}
const { title, description, publishDate, updatedDate, difficulty, duration, tags, image, ogImage } = Astro.props;
const fresh = freshness(publishDate, updatedDate);

const site = Astro.site;
const pageUrl = new URL(Astro.url.pathname, site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    datePublished: publishDate,
    ...(updatedDate ? { dateModified: updatedDate } : {}),
    proficiencyLevel: difficulty,
    keywords: tags.join(', '),
    author: { '@type': 'Organization', name: 'FullTVBox', url: site?.href },
    publisher: { '@type': 'Organization', name: 'FullTVBox', logo: { '@type': 'ImageObject', url: new URL('/og-default.png', site).href } },
    mainEntityOfPage: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Tutorials', item: new URL('/tutorials', site).href },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];

const difficultyColor = {
  beginner: 'text-signal border-signal/40',
  intermediate: 'text-amber border-amber/40',
  advanced: 'text-magenta border-magenta/40',
};
---
<BaseLayout title={title} description={description} ogImage={ogImage} ogType="article" publishDate={publishDate} modifiedDate={updatedDate}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <nav class="max-w-3xl mx-auto px-4 pt-8 label flex items-center gap-2" data-pagefind-ignore>
    <a href="/" class="hover:text-signal transition-colors">Home</a>
    <span class="text-line-bright">/</span>
    <a href="/tutorials" class="hover:text-signal transition-colors">Tutorials</a>
    <span class="text-line-bright">/</span>
    <span class="text-muted truncate">{title}</span>
  </nav>

  <article class="max-w-3xl mx-auto px-4 py-8" data-pagefind-body data-pagefind-filter="type:tutorial">
    {image && (
      <img src={image} alt={title} width="960" height="288" decoding="async" fetchpriority="high" class="w-full h-72 mb-8 object-contain bg-panel border border-line" onerror="this.style.display='none';" />
    )}

    <div class="label mb-3 flex items-center gap-2 flex-wrap">
      <span class="text-signal">TUTORIAL</span>
      {fresh === 'updated' && <span class="chip text-scope border-scope/40">◆ UPDATED</span>}
      {fresh === 'new' && <span class="chip text-signal border-signal/40">◆ NEW</span>}
      <span class="text-line-bright">·</span>
      <time>{new Date(publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      {updatedDate && (
        <span class="text-dim">· updated {new Date(updatedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
      )}
    </div>

    <h1 class="font-display font-900 text-4xl sm:text-5xl leading-[0.95] tracking-tight text-ink mb-4">{title}</h1>
    <p class="text-muted text-lg mb-6 leading-relaxed">{description}</p>

    <div class="flex items-center gap-2.5 mb-8 flex-wrap">
      <span class={`chip ${difficultyColor[difficulty]}`}>
        ◆ {difficulty}
      </span>
      <span class="chip">⏱ {duration}</span>
      {tags.map(tag => <span class="chip">{tag}</span>)}
    </div>

    <div class="smpte-bars h-1 w-full mb-10 opacity-60"></div>

    <div class="prose prose-invert prose-lg max-w-none prose-bench
      prose-headings:font-display prose-headings:text-ink
      prose-p:text-ink/85 prose-li:text-ink/85 prose-img:border prose-img:border-line
      prose-pre:bg-[#080b0f] prose-pre:border prose-pre:border-line">
      <slot />
    </div>
  </article>
</BaseLayout>
