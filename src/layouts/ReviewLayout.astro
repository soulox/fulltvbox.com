---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { freshness } from '../lib/freshness';
import { getAuthor, authorJsonLd } from '../data/authors';
import { TEST_WEEKS, CRITERIA_COUNT } from '../data/methodology';
import { resolveAffiliate } from '../lib/affiliate';
import { cleanPathname } from '../lib/url';
import { reviewImage } from '../lib/reviewImages';
import type { LiveDeal } from '../lib/deals';

interface Specs {
  releaseYear?: number; price?: number; soc?: string; cpu?: string; gpu?: string;
  ram?: string; storage?: string; os?: string; maxResolution?: string;
  hdr?: string[]; audio?: string[]; connectivity?: string[]; ports?: string[];
  remote?: string; dimensions?: string; weight?: string;
}
interface Props {
  title: string;
  description: string;
  publishDate: string;
  updatedDate?: string;
  rating: number;
  price?: number;
  affiliate?: string;
  specs?: Specs;
  deal?: LiveDeal;
  faq?: { question: string; answer: string }[];
  author?: string;
  ogImage?: string;
}
const { title, description, publishDate, updatedDate, rating, price, affiliate, specs, deal, faq, author: authorSlug, ogImage } = Astro.props;
const author = getAuthor(authorSlug);
const device = title.replace(/ Review.*$/i, '').trim();
const buyUrl = resolveAffiliate(affiliate, device);
const cleanPath = cleanPathname(Astro.url.pathname);
const slug = cleanPath.split('/').pop();
const hero = slug ? reviewImage(slug) : undefined;
const fresh = freshness(publishDate, updatedDate);

const segments = Array.from({ length: 5 }, (_, i) => {
  if (rating >= i + 1) return 'on';
  if (rating >= i + 0.5) return 'half';
  return 'off';
});

const specRows: [string, string][] = [
  ['releaseYear', 'Released'], ['price', 'Launch price'], ['soc', 'Chipset'], ['cpu', 'CPU'],
  ['gpu', 'GPU'], ['ram', 'RAM'], ['storage', 'Storage'], ['os', 'OS'],
  ['maxResolution', 'Max output'], ['hdr', 'HDR'], ['audio', 'Audio'],
  ['connectivity', 'Connectivity'], ['ports', 'Ports'], ['remote', 'Remote'],
  ['dimensions', 'Dimensions'], ['weight', 'Weight'],
];
const fmtSpec = (k: string, v: unknown) =>
  Array.isArray(v) ? v.join(', ') : k === 'price' ? `$${v}` : String(v);
const specEntries = specs
  ? specRows.filter(([k]) => specs[k as keyof Specs] != null).map(([k, label]) => [label, fmtSpec(k, specs[k as keyof Specs])] as [string, string])
  : [];

const site = Astro.site;
const pageUrl = new URL(cleanPath, site).href;

// Brand for the reviewed product, detected from the device name (satisfies the
// "global identifier" recommendation). We review products; we don't sell them, so
// the Product carries no commerce `offers` — that keeps this an editorial product
// *review* snippet rather than a merchant listing (which would require seller-only
// fields like shippingDetails and a return policy we don't control).
const brandTable: [string, string][] = [
  ['apple', 'Apple'], ['fire tv', 'Amazon'], ['amazon', 'Amazon'], ['chromecast', 'Google'],
  ['google', 'Google'], ['nvidia', 'NVIDIA'], ['shield', 'NVIDIA'], ['roku', 'Roku'],
  ['tivo', 'TiVo'], ['xiaomi', 'Xiaomi'], ['mi box', 'Xiaomi'], ['onn', 'onn'], ['walmart', 'onn'],
];
const haystack = device.toLowerCase();
const brand = (brandTable.find(([k]) => haystack.includes(k)) ?? [])[1];

// Product as the top-level entity with the editorial review nested inside it —
// Google's recommended shape for a product-review page. It satisfies the product
// snippet requirement (a `review` is present), yields the star-rating snippet, and
// carries no `offers`, so it stays a review snippet rather than a merchant listing.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: device,
  description,
  ...(hero ? { image: new URL(hero.src, site).href } : {}),
  ...(brand ? { brand: { '@type': 'Brand', name: brand } } : {}),
  review: {
    '@type': 'Review',
    name: title,
    datePublished: publishDate,
    ...(updatedDate ? { dateModified: updatedDate } : {}),
    author: authorJsonLd(author, site),
    publisher: { '@type': 'Organization', name: 'FullTVBox', logo: { '@type': 'ImageObject', url: new URL('/og-default.png', site).href } },
    reviewRating: { '@type': 'Rating', ratingValue: rating, bestRating: 5, worstRating: 1 },
  },
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: new URL('/reviews', site).href },
    { '@type': 'ListItem', position: 3, name: device, item: pageUrl },
  ],
};
---
<BaseLayout title={title} description={description} ogImage={ogImage} ogType="article" publishDate={publishDate} modifiedDate={updatedDate}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([jsonLd, breadcrumb])} />
  </Fragment>

  <!-- Breadcrumbs -->
  <nav class="max-w-3xl mx-auto px-4 pt-8 label flex items-center gap-2" data-pagefind-ignore>
    <a href="/" class="hover:text-signal transition-colors">Home</a>
    <span class="text-line-bright">/</span>
    <a href="/reviews" class="hover:text-signal transition-colors">Reviews</a>
    <span class="text-line-bright">/</span>
    <span class="text-muted truncate">{device}</span>
  </nav>

  <article class="max-w-3xl mx-auto px-4 py-8" data-pagefind-body data-pagefind-filter="type:review">

    {hero && (
      <Image
        src={hero}
        alt={`${device} — product photo`}
        widths={[480, 768, 960]}
        sizes="(max-width: 768px) 100vw, 768px"
        format="webp"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="w-full h-72 mb-8 object-contain bg-panel border border-line"
      />
    )}
    <div
      class:list={['w-full mb-8 h-52 panel frame items-center justify-center relative overflow-hidden', hero ? 'hidden' : 'flex']}
    >
      <div class="absolute inset-0 smpte-bars opacity-[0.07]"></div>
      <div class="relative text-center px-6">
        <div class="label text-signal mb-2 flex items-center justify-center gap-2"><span class="tally tally-sm"></span> NO SIGNAL — STANDBY</div>
        <div class="font-display font-800 text-2xl text-ink leading-snug">{device}</div>
      </div>
    </div>

    <div class="label mb-3 flex items-center gap-2 flex-wrap">
      <span class="text-signal">REVIEW</span>
      {fresh === 'updated' && <span class="chip text-scope border-scope/40">◆ UPDATED</span>}
      {fresh === 'new' && <span class="chip text-signal border-signal/40">◆ NEW</span>}
      <span class="text-line-bright">·</span>
      <span>By <a href={author.url} class="text-muted hover:text-signal transition-colors">{author.name}</a></span>
      <span class="text-line-bright">·</span>
      <time>{new Date(publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      {updatedDate && (
        <span class="text-dim">· updated {new Date(updatedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
      )}
      <span class="text-line-bright">·</span>
      <a href="/how-we-test" class="text-dim hover:text-signal transition-colors">how we test</a>
    </div>

    <h1 class="font-display font-900 text-4xl sm:text-5xl leading-[0.95] tracking-tight text-ink mb-4">{title}</h1>
    <p class="text-muted text-lg mb-8 leading-relaxed">{description}</p>

    <!-- verdict panel -->
    <div class="panel frame mb-6">
      <div class="px-5 sm:px-6 py-5 flex items-center gap-6 flex-wrap">
        <div>
          <div class="label mb-2">Bench score</div>
          <div class="meter">
            {segments.map(s => <span class={`seg ${s}`}></span>)}
          </div>
        </div>
        <div class="flex items-end gap-1">
          <span class="font-display font-900 text-5xl text-signal leading-none glow-text">{rating.toFixed(1)}</span>
          <span class="label mb-1">/ 5.0</span>
        </div>

        <div class="ml-auto flex items-center gap-4 flex-wrap">
          {deal ? (
            <div class="flex items-center gap-4">
              <div class="text-right">
                <div class="flex items-end gap-1.5">
                  <span class="font-display font-900 text-2xl text-signal leading-none">${deal.price}</span>
                  {deal.wasPrice && <span class="font-mono text-xs text-dim line-through mb-0.5">${deal.wasPrice}</span>}
                </div>
                <div class="label text-dim mt-0.5">{deal.retailer}{deal.discountPct ? ` · -${deal.discountPct}%` : ''}</div>
              </div>
              <a href={deal.url} target="_blank" rel="noopener sponsored" class="btn-signal">Get deal →</a>
            </div>
          ) : buyUrl ? (
            <a href={buyUrl} target="_blank" rel="noopener sponsored" class="btn-signal">
              Check Price →{price ? ` $${price}` : ''}
            </a>
          ) : null}
        </div>
      </div>
      <div class="px-5 sm:px-6 py-2.5 border-t border-line flex items-center gap-x-3 gap-y-1 flex-wrap">
        <span class="label text-dim">Independent · bought or borrowed · {TEST_WEEKS}+ weeks hands-on · scored on {CRITERIA_COUNT} criteria</span>
        <a href="/how-we-test" class="label text-muted hover:text-signal transition-colors ml-auto">How we score →</a>
      </div>
      <div class="smpte-bars h-1 w-full opacity-70"></div>
    </div>

    <!-- compare affordance -->
    <div class="flex items-center gap-3 mb-10">
      <a href={`/compare?ids=${slug}`} class="btn-ghost !px-4 !py-2" data-compare-add={slug}>+ Add to compare</a>
      {deal && <span class="label text-dim">Live deal active · prices change fast</span>}
    </div>

    {specEntries.length > 0 && (
      <section id="specs" class="panel frame mb-10" aria-label="Specifications">
        <div class="px-5 sm:px-6 py-4 border-b border-line flex items-center gap-2">
          <span class="tally tally-sm"></span>
          <span class="label text-signal">// Spec sheet</span>
        </div>
        <dl class="divide-y divide-line">
          {specEntries.map(([label, value]) => (
            <div class="px-5 sm:px-6 py-3 grid grid-cols-[8rem_1fr] gap-4 items-baseline">
              <dt class="label text-dim">{label}</dt>
              <dd class="text-ink/90 text-sm font-mono">{value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <div class="prose prose-invert prose-lg max-w-none prose-bench
      prose-headings:font-display prose-headings:text-ink
      prose-p:text-ink/85 prose-li:text-ink/85 prose-img:border prose-img:border-line">
      <slot />
    </div>

    {faq && faq.length > 0 && (
      <div class="mt-14">
        <Faq items={faq} />
      </div>
    )}
  </article>

  <slot name="related" />
</BaseLayout>
