---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  rating: number;
  image?: string;
  affiliate?: string;
}
const { title, description, publishDate, rating, image, affiliate } = Astro.props;
const stars = Math.round(rating);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: title,
  description,
  datePublished: publishDate,
  author: {
    '@type': 'Organization',
    name: 'FullTVBox',
    url: 'https://fulltvbox.com',
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: rating,
    bestRating: 5,
    worstRating: 1,
  },
  itemReviewed: {
    '@type': 'Product',
    name: title.replace(/ Review.*$/i, '').trim(),
  },
};
---
<BaseLayout title={title} description={description} image={image}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <nav class="max-w-3xl mx-auto px-4 pt-6 text-sm text-gray-500 flex items-center gap-2">
    <a href="/" class="hover:text-white transition-colors">Home</a>
    <span>/</span>
    <a href="/reviews" class="hover:text-white transition-colors">Reviews</a>
    <span>/</span>
    <span class="text-gray-400 truncate">{title.replace(/ Review.*$/i, '').trim()}</span>
  </nav>

  <article class="max-w-3xl mx-auto px-4 py-8">

    {image ? (
      <img src={image} alt={title} class="w-full rounded-xl mb-8 object-cover max-h-72" />
    ) : (
      <div class="w-full rounded-xl mb-8 h-48 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 border border-gray-800 flex items-center justify-center relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-brand/10 to-transparent" />
        <div class="relative text-center px-6">
          <div class="text-brand text-4xl mb-2">📺</div>
          <div class="text-white font-bold text-lg leading-snug">{title.replace(/ Review.*$/i, '').trim()}</div>
        </div>
      </div>
    )}

    <div class="mb-2 text-sm text-gray-500">
      <time>{new Date(publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
    </div>

    <h1 class="text-3xl font-bold text-white mb-4">{title}</h1>
    <p class="text-gray-400 text-lg mb-6">{description}</p>

    <div class="flex items-center gap-3 mb-8 p-4 bg-gray-900 rounded-xl border border-gray-800">
      <div class="text-yellow-400 text-xl">
        {'★'.repeat(stars)}{'☆'.repeat(5 - stars)}
      </div>
      <span class="text-2xl font-bold text-white">{rating}<span class="text-gray-500 text-base">/5</span></span>
      {affiliate && (
        <a href={affiliate} target="_blank" rel="noopener sponsored" class="ml-auto bg-brand hover:bg-brand-dark text-white font-semibold px-5 py-2 rounded-lg transition-colors text-sm">
          Check Price →
        </a>
      )}
    </div>

    <div class="prose prose-invert prose-lg max-w-none
      prose-headings:font-bold prose-headings:text-white
      prose-p:text-gray-300 prose-li:text-gray-300
      prose-a:text-brand prose-a:no-underline hover:prose-a:underline">
      <slot />
    </div>
  </article>

  <slot name="related" />
</BaseLayout>
